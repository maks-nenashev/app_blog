<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="card shadow-lg border-0 rounded-4 p-4 bg-light">
        <h2 class="text-center mb-4 text-primary fw-bold">
          <%= t('.title', default: "Редагувати профіль") %>
        </h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <!-- Аватар -->
          <div class="text-center mb-3">
            <%= image_tag current_user.avatar_tumbnail, class: "rounded-circle shadow zoom", size: "100x100" %>
          </div>

          <div class="mb-3">
            <%= f.label :avatar, "Оновити фото", class: "form-label fw-semibold" %>
            <%= f.file_field :avatar, class: "form-control shadow-sm" %>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <%= f.label :email, "Email", class: "form-label fw-semibold" %>
            <%= f.email_field :email, class: "form-control shadow-sm", autofocus: true, autocomplete: "email" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="alert alert-info shadow-sm">
              Підтвердження очікується для: <%= resource.unconfirmed_email %>
            </div>
          <% end %>

          <!-- Username -->
          <div class="mb-3">
            <%= f.label :username, "Ім’я користувача", class: "form-label fw-semibold" %>
            <%= f.text_field :username, class: "form-control shadow-sm", autocomplete: "username" %>
          </div>

          <!-- New Password -->
          <div class="mb-3">
            <%= f.label :password, "Новий пароль", class: "form-label fw-semibold" %>
            <%= f.password_field :password, class: "form-control shadow-sm", autocomplete: "new-password" %>
            <% if @minimum_password_length %>
              <small class="text-muted"><%= @minimum_password_length %> символів мінімум</small>
            <% end %>
          </div>

          <!-- Password confirmation -->
          <div class="mb-3">
            <%= f.label :password_confirmation, "Підтвердження пароля", class: "form-label fw-semibold" %>
            <%= f.password_field :password_confirmation, class: "form-control shadow-sm", autocomplete: "new-password" %>
          </div>

          <!-- Current Password -->
          <div class="mb-3">
            <%= f.label :current_password, "Поточний пароль (для підтвердження)", class: "form-label fw-semibold" %>
            <%= f.password_field :current_password, class: "form-control shadow-sm", autocomplete: "current-password" %>
          </div>

          <!-- Submit -->
          <div class="d-grid mt-4">
            <%= f.submit "Зберегти зміни", class: "btn btn-success shadow" %>
          </div>
        <% end %>

        <!-- Cancel account -->
        <div class="mt-4 text-center">
          <h5 class="fw-bold">Видалити акаунт</h5>
          <%= button_to "Видалити акаунт", registration_path(resource_name), method: :delete, data: { confirm: "Ви впевнені?" }, class: "btn btn-outline-danger btn-sm mt-2 shadow-sm" %>
        </div>

        <!-- Back -->
        <div class="mt-3 text-center">
          <%= link_to "Назад", :back, class: "btn btn-outline-secondary btn-sm shadow-sm" %>
        </div>

      </div>

    </div>
  </div>
</section>


