<%= form_with model: [@article, @comment], html: { class: 'card shadow-lg p-4 rounded-4 bg-light' } do |f| %>
  <!-- Поле для заголовка -->
  <div class="mb-4 row">
    <div class="col-sm-3 col-form-label">
      <%= f.label :title, 'Заголовок', class: 'form-label fw-bold text-primary' %>
    </div>
    <div class="col-sm-9">
      <%= f.text_field :title, placeholder: "Введите заголовок", class: "form-control shadow-lg rounded-3", required: true, minlength: 2 %>
    </div>
  </div>

  <!-- Поле для текста -->
  <div class="mb-4 row">
    <div class="col-sm-3 col-form-label">
      <%= f.label :body, 'Комментарий', class: 'form-label fw-bold text-primary' %>
    </div>
    <div class="col-sm-9">
      <%= f.text_area :body, placeholder: "Введите текст", class: 'form-control shadow-lg rounded-3', required: true, minlength: 2 %>
    </div>
  </div>

  <!-- Поле для загрузки изображения -->
  <!-- Загрузка изображения -->
          <div class="mb-3">
           <label class="btn btn-dark">
            Upload image
             <%= f.file_field :image, style: "display: none;" %>
            </label>
          </div>

  <!-- Кнопка отправки -->
  <div class="d-flex justify-content-end">
    <%= f.submit t('.submit_button'), class: 'btn btn-success btn-lg fw-bold shadow-lg' %>
  </div>
<% end %>
