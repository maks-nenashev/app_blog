<% provide :page_title, 'Comment Form' %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="card shadow-lg border-0 rounded-4 p-4 bg-white">
        <!-- Заголовок -->
        <h2 class="text-center mb-4 text-primary fw-bold">
          <%= t('.title', default: "Комментарий") %>
        </h2>

        <%= form_with model: [@article, @comment], html: { class: "needs-validation", novalidate: true } do |f| %>
          <!-- Ошибки -->
          <%= render 'shared/errors', object: @comment %>

          <!-- Заголовок -->
          <div class="mb-3">
            <%= f.label :title, "Заголовок комментария", class: "form-label fw-semibold" %>
            <%= f.text_field :title,
                             placeholder: "Введите заголовок",
                             class: "form-control shadow-sm",
                             required: true,
                             minlength: 2 %>
          </div>

          <!-- Текст -->
          <div class="mb-3">
            <%= f.label :body, "Текст комментария", class: "form-label fw-semibold" %>
            <%= f.text_area :body,
                            placeholder: "Введите текст",
                            class: "form-control shadow-sm",
                            rows: 5,
                            required: true,
                            minlength: 2 %>
          </div>

          <!-- Загрузка изображения -->
          <div class="mb-3">
           <label class="btn btn-dark">
            Upload image
             <%= f.file_field :image, style: "display: none;" %>
            </label>
          </div>
          
          <!-- Кнопка -->
          <div class="d-grid mt-4">
            <%= f.submit t('.submit_button', default: "Отправить"), class: "btn btn-success btn-lg shadow" %>
          </div>
        <% end %>

      </div>

    </div>
  </div>
</section>


