<h1><%= t'.title'%></h1>

<%= form_with model: [@article, @comment] do |f| %>
  <div class="mb-3 row">
  <div class="col-sm-2 col-form-label">  
     <%= f.label :title %>
      </div>

  <div class="col-sm-10">          <! Walidacija CSS ---required: true, minlength:2,>
      <%= f.text_field :title, placeholder: "Title", class: "form-control"%>
     </div>
    </div>
  <div class="mb-3 row">
    <div class="col-sm-2 col-form-label">
      <%= f.label :body %>
    </div>

    <div class="col-sm-10">                    <! Walidacija CSS ---required: true, minlength:2,>
      <%= f.text_area :body, placeholder: "Text", class: 'form-control', required: true, minlength:2 %>
    </div>
  </div>
    <div class="col-sm-10">     
      <%= f.file_field :image, class: "btn btn-outline-primary btn-sm"%>
    </div>
      <br>
  <%= f.submit t('.submit_button'), class: 'btn btn-primary' %>
<% end %>

