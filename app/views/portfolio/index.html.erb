<!-- Native HTML5 Dialog Modal FindWay Mobile -->
<dialog id="findWayMobileDialog" class="p-0 border-0 rounded-4 shadow-lg" style="max-width: 420px; width: 90%; background: #050505; color: #fff;">
  <div class="p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold m-0 fs-6" style="color: #027dfd;">FindWay Mobile Preview</h5>
      <button type="button" 
              class="btn-close btn-close-white" 
              onclick="const d = document.getElementById('findWayMobileDialog'); d.querySelector('video').pause(); d.close();" 
              aria-label="Close"></button>
    </div>
    
    <div class="position-relative" style="width: 100%; padding-top: 177.77%; border-radius: 20px; overflow: hidden; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
      <video controls preload="metadata" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;">
        <source src="<%= asset_path('FindWay_mobile.mp4') %>" type="video/mp4">
        Текущий браузер не поддерживает HTML5 видео.
      </video>
    </div>
  </div>
</dialog>

