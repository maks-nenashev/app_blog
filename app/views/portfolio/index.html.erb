             class="btn btn-sm w-100 shadow-sm" style="background:linear-gradient(90deg, #246bfd 0%, #18e1b5 100%); color:#fff; border:none; border-radius:10px;">
             🌍 Visit project
          </a>
        </div>
      </div>
    </div>
  </div>
    
    <!-- FindWay AI Moderator -->
