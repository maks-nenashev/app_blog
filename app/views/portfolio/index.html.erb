        <p class="card-text small">
          <%= t('.title_6') %>
        </p>
        
        <details class="mb-3">
          <summary style="cursor: pointer; color: #ff4757;" class="small fw-bold"><%= t('.read_6') %></summary>
          <p class="mt-2 small">
         <%= t('.text_6').html_safe %>
        </p>
        </details>
        
        <div class="mt-auto">
          <div class="mb-3">
            <span class="tech-badge">Python</span>
            <span class="tech-badge">PyTorch</span>
