<div class="col">
  <div class="card h-100 shadow-lg border-0 rounded-4 project-card">
    <%# Рекомендую использовать скриншот дашборда Графаны %>
    <%= image_tag "monitoring.png", class: "card-img-top rounded-top-4", alt: "Systems Monitoring & AI" %>
    
    <div class="card-body d-flex flex-column">
      <h5 class="card-title fw-bold" style="color: #027dfd;">Systems Monitoring & AI</h5>
      <span class="badge bg-light text-success border mb-2 align-self-start">Operational / High Stability</span>
      
      <p class="card-text small">
        <%= t('.monitoring_title', default: 'Distributed monitoring system with integrated AI moderation pipeline. Real-time observability and content safety control.') %>
      </p>

      <details class="mb-3">
        <summary style="cursor: pointer; color: #027dfd;" class="small fw-bold">
          <%= t('.monitoring_read', default: 'System Architecture') %>
        </summary>
        <p class="mt-2 small text-muted">
          <%= t('.monitoring_text', default: 'Deployed on Hetzner Cloud via Docker.
           Observability stack: Prometheus for metrics collection and Grafana 
           for visual telemetry. AI layer: CNN (EfficientNet/FaceNet) 
           and NLP moderators ensuring policy-first content control.') %>
        </p>
      </details>

      <div class="mt-auto">
        <div class="mb-3">
          <span class="tech-badge" style="background: #e6522c; color: #fff;">Prometheus</span>
          <span class="tech-badge" style="background: #f47b20; color: #fff;">Grafana</span>
          <span class="tech-badge">Docker</span>
          <span class="tech-badge">Hetzner</span>
          <span class="tech-badge text-info border">CNN/NLP Moderators</span>
          <span class="tech-badge text-info border">Rails data platform</span>
        </div>
        <%# Ссылка на Grafana или внутренний статус-репорт %>
        <a href="#" class="btn btn-sm w-100 shadow-sm" style="background: linear-gradient(90deg, #198754 0%, #116a3d 100%); color: #fff; border: none; border-radius: 10px;">
           📊 Open Health Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

  </div>
</div>

<style>
  /* Эффект при наведении на карточку */
  .project-card {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease;
  }
  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
  }

<style>
  /* Анимация и подъем карточки */
  .project-card { 
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease; 
  }
  
  .project-card:hover { 
    transform: translateY(-8px); 
    box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important; 
  }

  /* Дизайн тегов стека технологий */
  .tech-badge {
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-size: 0.7rem; 
    font-weight: 600; 
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 3px 8px; 
    border-radius: 6px;
    background: #f1f5f9; 
    color: #475569; 
    border: 1px solid #e2e8f0;
    display: inline-block; 
    margin-bottom: 4px; 
    margin-right: 2px;
  }

  /* Акцент на раскрывающемся тексте */
  details p {
    border-left: 2px solid #e2e8f0;
    padding-left: 1rem;
    color: #64748b;
    margin-top: 0.5rem;
  }
</style>