<div class="container my-5">
   <!-- Header with title -->
<h1 class="text-center animate__animated animate__fadeInDown display-4 fw-bold my-5" style="font-family: 'Aboreto', cursive; color: #333;">
  <%= t('.main_slogan', default: 'Where ideas come to life') %>
</h1>
  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    
    <!-- FindWay -->
    <div class="col">
      <div class="card h-100 shadow-lg border-0 rounded-4 project-card">
        <%= image_tag "findway_new.png", class: "card-img-top rounded-top-4", alt: "FindWay" %>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title fw-bold text-primary">FindWay</h5>
          <a href="https://findway.pro" target="_blank" rel="noopener" class="small mb-2 d-inline-block">findway.pro</a>
          <p class="card-text small"><%= t('.title_1') %></p>
          <details class="mb-3">
            <summary class="text-primary small fw-bold" style="cursor: pointer;"><%= t('.read_1') %></summary>
            <p class="mt-2 small"><%= t('.text_1') %></p>
          </details>
          <div class="mt-auto">
            <div class="mb-3">
              <span class="tech-badge">Ruby on Rails</span>
              <span class="tech-badge">i18n</span>
              <span class="tech-badge">OmniAuth</span>
              <span class="tech-badge">AWS SES</span>
              <span class="tech-badge">S3</span>
              <span class="tech-badge">Sidekiq</span>
              <span class="tech-badge">Docker</span>
              <span class="tech-badge">Hetzner</span>
              <span class="tech-badge">Nginx</span>
            </div>
            <a href="https://findway.pro" class="btn btn-sm w-100 shadow-sm" style="background:linear-gradient(90deg, #246bfd 0%, #18e1b5 100%); color:#fff; border:none; border-radius:10px;">🌍 Visit project</a>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card h-100 shadow-lg border-0 rounded-4 project-card">
        <%= image_tag "dashboard.png", class: "card-img-top rounded-top-4", alt: "Shiny Dashboard" %>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title fw-bold text-success"><%= t('.title_2_1') %></h5>
          <a href="https://statauto.net" target="_blank" rel="noopener" class="small mb-2 d-inline-block">statauto.net</a>
          <p class="card-text small"><%= t('.title_2') %></p>
          <details class="mb-3">
            <summary class="text-info small fw-bold" style="cursor: pointer;"><%= t('.read_2') %></summary>
            <p class="mt-2 small"><%= t('.text_2') %></p>
          </details>
          <div class="mt-auto">
            <div class="mb-3">
              <span class="tech-badge">R</span>
              <span class="tech-badge">Shiny</span>
              <span class="tech-badge">ETL</span>
              <span class="tech-badge">Time Series</span>
              <span class="tech-badge">ARIMA</span>
              <span class="tech-badge">Linear Regression</span>
              <span class="tech-badge">Docker</span>
              <span class="tech-badge">S3</span>
              <span class="tech-badge">Hetzner</span>
            </div>
            <a href="https://statauto.net" class="btn btn-sm w-100 shadow-sm" style="background:linear-gradient(90deg, #246bfd 0%, #18e1b5 100%); color:#fff; border:none; border-radius:10px;">🌍 Visit project</a>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card h-100 shadow-lg border-0 rounded-4 project-card">
        <%= image_tag "maksym-social.png", class: "card-img-top rounded-top-4", alt: "Maksym Social" %>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title fw-bold text-dark">Maksym Social</h5>
          <%= link_to "nenashev.net", articles_path, class: "small mb-2 d-inline-block" %>
          <p class="card-text small"><%= t('.title_3') %></p>
          <details class="mb-3">
            <summary class="text-dark small fw-bold" style="cursor: pointer;"><%= t('.read_3') %></summary>
            <p class="mt-2 small"><%= t('.text_3') %></p>
          </details>
          <div class="mt-auto">
            <div class="mb-3">
              <span class="tech-badge">Ruby on Rails</span>
              <span class="tech-badge">Bootstrap 5</span>
              <span class="tech-badge">i18n</span>
              <span class="tech-badge">S3</span>
              <span class="tech-badge">Sidekiq</span>
              <span class="tech-badge">Docker</span>
              <span class="tech-badge">Hetzner</span>
              <span class="tech-badge">Nginx</span>
            </div>
            <a href="<%= articles_path %>" class="btn btn-sm w-100 shadow-sm" style="background:linear-gradient(90deg, #246bfd 0%, #18e1b5 100%); color:#fff; border:none; border-radius:10px;">🌍 Visit articles</a>
          </div>
        </div>
      </div>
    </div>

    <!-- PromoFindWay Landing -->
