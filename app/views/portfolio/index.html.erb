        <p class="card-text small">
          <%= t('.title_4').html_safe %>
        </p>
        
        <details class="mb-3">
          <summary style="cursor: pointer; color: #9d72ff;" class="small fw-bold"><%= t('.read_4') %></summary>
          <p class="mt-2 small"><%= t('.text_4').html_safe %></p>
        </details>
        
        <div class="mt-auto">
          <div class="mb-3">
            <span class="tech-badge">Ruby</span>
            <span class="tech-badge">Sinatra</span>
            <span class="tech-badge">Bootstrap 5</span>
            <span class="tech-badge">Docker</span>
            <span class="tech-badge">i18n</span>
            <span class="tech-badge">Nginx</span>
            <span class="tech-badge">Hetzner</span>
          </div>
