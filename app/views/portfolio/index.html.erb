    </div>
  </div>
  
    <!-- FindWay Mobile App -->
  <div class="col">
  <div class="card h-100 shadow-lg border-0 rounded-4 project-card">
    <%# Рекомендую заменить на скриншот мобильного интерфейса %>
    <%= image_tag "phone.jpg", class: "card-img-top rounded-top-4", alt: "FindWay Mobile App" %>
    
    <div class="card-body d-flex flex-column">
      <h5 class="card-title fw-bold" style="color: #027dfd;">FindWay Mobile</h5>
      <span class="badge bg-light text-primary border mb-2 align-self-start">Under Development</span>
      
      <p class="card-text small">
        <%= t('.mobile_title', default: 'Cross-platform mobile application for iOS and Android. Seamless integration with FindWay ecosystem.') %>
      </p>

      <details class="mb-3">
        <summary style="cursor: pointer; color: #027dfd;" class="small fw-bold">
          <%= t('.mobile_read', default: 'Development Details') %>
        </summary>
        <p class="mt-2 small">
          <%= t('.mobile_text', default: 'Building a unified experience using Flutter. The app consumes Rails REST API, implementing secure authentication, real-time data sync, and offline-first capabilities.') %>
        </p>
      </details>

      <div class="mt-auto">
        <div class="mb-3">
          <span class="tech-badge">Dart</span>
          <span class="tech-badge">Flutter</span>
          <span class="tech-badge">REST API</span>
          <span class="tech-badge">Riverpod</span>
