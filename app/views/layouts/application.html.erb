<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= full_title(yield(:page_title)) %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Styles -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "home", "articles", "devise", "tweets", "portfolio", "data-turbo-track": "reload" %>

    <!-- Scripts -->
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%#= javascript_include_tag "custom.js", "home.js", "articles.js", "devise.js", "tweets.js", "data-turbo-track": "reload" %>

</head>

<body>
  <div class="container mt-3">
    <!-- Header -->
<header class="bg-white shadow-lg py-3 mb-4 border-bottom">
  <div class="container-fluid">
    <nav class="navbar navbar-expand-lg navbar-light">
      <div class="d-flex w-100 justify-content-between align-items-center">
        <!-- Лого -->
        <!--h2 class="navbar-brand fw-bold text-primary text-shadow m-0"><!/h2-->
        <h2 class="navbar-brand fw-bold text-primary m-0" style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);">
          Maksym Nenashev
        </h2>
 
        <!-- Кнопка бургер для мобильных -->
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Ссылки адаптированные для мобильной и обычной версии -->
        <ul class="nav d-none d-lg-flex align-items-center gap-3 m-0">
          <li><%= link_to t('menu.home'), root_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.articles'), articles_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to "Portfolio", portfolio_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-3 text-primary fw-semibold' %></li>
        </ul>
        
        <!-- Подключение языков -->
   <div class="d-none d-lg-flex align-items-center gap-3"> 
          <div class="dropdown">
            <%= link_to '#', class: 'nav-link px-2 d-flex align-items-center', data: { "bs-toggle": 'dropdown' } do %>
            <%= image_tag("flags/#{locale}.svg", alt: locale, width: 20, height: 15, class: "me-2") %>
              <%= t(locale) %>
            <% end %>
    <ul class="dropdown-menu dropdown-menu-dark">
            <% I18n.available_locales.each do |locale| %>
      <li>
            <% if I18n.locale == locale %>
             <span class="dropdown-item d-flex align-items-center">
                 <%= image_tag("flags/#{locale}.svg", alt: locale, width: 20, height: 15, class: "me-2") %>
                <%= t(locale) %>
             </span>
            <% else %>
                <%= link_to url_for(locale: locale), class: 'dropdown-item d-flex align-items-center', data: { turbo: false } do %>
                <%= image_tag("flags/#{locale}.svg", alt: locale, width: 20, height: 15, class: "me-2") %>
                <%= t(locale) %>
             <% end %>
           <% end %>
      </li>
     <% end %>
    </ul>
  </div>

          <!-- Профиль пользователя -->
          <% if user_signed_in? %>
            <%= image_tag current_user.avatar_tumbnail, class: "avatar rounded-circle shadow-sm", size: "40x40" %>
            <strong><%= current_user.username %></strong>
            <%= link_to "Edit Account", edit_user_registration_path, class: 'text-decoration-none text-dark' %>
            <%= link_to t('menu.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-sm bi bi-door-closed-fill" %>
          <% else %>
            <%= link_to t('menu.sign_in'), new_user_session_path, class: "btn btn-outline-primary btn-sm bi bi-door-open-fill" %>
          <% end %>
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- Side panel (offcanvas) for mobile -->
    <div class="offcanvas offcanvas-end text-bg-white" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">Меню</h5>
        <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
       
        <!-- User profile or login/logout -->
        <ul class="nav col-12 col-lg-auto mb-2 mb-md-0 px-3">
          <li>
            <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-2"> <!--All one line-->
            <%= image_tag current_user.avatar_tumbnail, class: "avatar rounded-circle", size: "40x40" %>
              <strong><%= current_user.username %></strong>
            <%= link_to "Edit Account", edit_user_registration_path, class: 'nav-link px-2 text-dark' %>
        </div> 
              <br>
              <%= link_to t('menu.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-sm bi bi-door-closed-fill" %>
            <% else %>
              <%= link_to t('menu.sign_in'), new_user_session_path, class: "btn btn-outline-primary btn-sm bi bi-door-open-fill" %>
            <% end %>
          </li>
        </ul>
      
      
      <div class="offcanvas-body">
        <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
          <!-- Home link -->
          <li class="nav-item">
            <%= link_to t('menu.home'), root_path, class: 'nav-link px-3 text-dark bi bi-house-door' %>
          </li>
          <!-- Articles link -->
          <li class="nav-item">
            <%= link_to t('menu.articles'), articles_path, class: 'nav-link px-3 text-dark bi bi-journals' %>
          </li>
          <li class="nav-item">
            <%= link_to "Portfolio", portfolio_path, class: 'nav-link px-3 text-dark fw-semibold' %>
          </li>
          <!-- Contacts link -->
          <li class="nav-item">
            <%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-3 text-dark bi bi-tencent-qq' %>
          </li>
          <!-- Admin link (if authorized) -->
          <% if policy([:user]).index? %>
            <li class="nav-item">
              <%= link_to t('menu.admin'), admin_users_path, class: 'nav-link px-3 text-dark' %>
            </li>
          <% end %>
           <li>
              <%#= link_to "Edit Accunt", edit_user_registration_path, class: 'nav-link px-3 text-dark'%>
          </li>
        </ul>

                    <!Podkluchenie Jazykow >
        <div class="mt-3 px-3">
  <div class="dropdown">
    <%= link_to '#', class: 'btn btn-light dropdown-toggle w-100 d-flex align-items-center justify-content-center',
        data: { "bs-toggle": 'dropdown' } do %>
      <%= image_tag("flags/#{I18n.locale}.svg", alt: I18n.locale, width: 20, height: 15, class: "me-2") %>
      <%= t I18n.locale %>
    <% end %>
    
    <ul class="dropdown-menu w-100">
      <% I18n.available_locales.each do |locale| %>
        <% unless I18n.locale == locale %>
          <li>
            <%= link_to url_for(locale: locale), data: { turbo: false },
                class: "dropdown-item d-flex align-items-center" do %>
              <%= image_tag("flags/#{locale}.svg", alt: locale, width: 20, height: 15, class: "me-2") %>
              <%= t(locale) %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>
      
      
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="container mt-3">
    <% flash.each do |key, value| %>
       <div class="container mt-4">
       <div class="alert alert-<%= key == 'notice' ? 'success' : 'danger' %> text-center shadow">
        <%= value %>
       </div>
       </div>
    <% end %>
   <%= yield %>
  </main>

</body>

</html>
