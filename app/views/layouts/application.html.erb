<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= full_title(yield(:page_title)) %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&display=swap" rel="stylesheet">
    <!-- Google site verification -->
    <% if Rails.env.production? %>
        <meta name="google-site-verification" content="HK2wIp1pfa8btw42sbHU-LxcTzPWHHpmaD4H4tUKNms" />
    <% end %>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Styles -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "home", "articles", "devise", "tweets", "portfolio", "data-turbo-track": "reload" %>

    <!-- Scripts -->
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%#= javascript_include_tag "custom.js", "home.js", "articles.js", "devise.js", "tweets.js", "data-turbo-track": "reload" %>
   
      <!-- Favicon and Manifest -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png">
    <!-- Apple -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="shortcut icon" href="/favicon.ico">
</head>

<body>
  <div class="container mt-3">
    <!-- Header -->
<header class="bg-white shadow-lg py-3 mb-4 border-bottom">
  <div class="container-fluid">
    <nav class="navbar navbar-expand-lg navbar-light">
      <div class="d-flex w-100 justify-content-between align-items-center">
        <!-- Лого -->
        <!--h2 class="navbar-brand fw-bold text-primary text-shadow m-0"><!/h2-->
        <h2 class="navbar-brand fw-bold text-primary m-0" style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);">
          Maksym Nenashev
        </h2>
 
        <!-- Кнопка бургер для мобильных -->
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Ссылки адаптированные для мобильной и обычной версии -->
        <ul class="nav d-none d-lg-flex align-items-center gap-3 m-0">
          <li><%= link_to t('menu.home'), root_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.articles'), articles_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.portfolio'), portfolio_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.manuscripts'), manuscripts_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
          <li><%= link_to t('menu.gallery'), gallery_path, class: 'nav-link px-3 text-dark fw-semibold' %></li>
           <!--li><%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-3 text-primary fw-semibold' %></li-->
        </ul>
        
<!-- Подключение языков и авторизация -->
<div class="d-none d-lg-flex align-items-center gap-3"> 
  
  <!-- Выпадающий список языков (Pill Style) -->
  <div class="dropdown">
    <%= link_to '#', class: 'btn-header-pill dropdown-toggle', data: { "bs-toggle": 'dropdown' } do %>
      <%= image_tag("flags/#{locale}.svg", alt: locale, width: 18, height: 13, class: "me-2 rounded-1") %>
      <span><%= locale.to_s.upcase %></span>
    <% end %>
    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 py-2">
      <% I18n.available_locales.each do |loc| %>
        <li>
          <% if I18n.locale == loc %>
            <span class="dropdown-item active fw-semibold d-flex align-items-center gap-2">
              <%= image_tag("flags/#{loc}.svg", alt: loc, width: 18, height: 13, class: "rounded-1") %>
              <%= t(loc) %>
            </span>
          <% else %>
            <%= link_to url_for(locale: loc), class: 'dropdown-item d-flex align-items-center gap-2', data: { turbo: false } do %>
              <%= image_tag("flags/#{loc}.svg", alt: loc, width: 18, height: 13, class: "rounded-1") %>
              <%= t(loc) %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="vr h-50 my-auto text-muted opacity-25"></div>

  <!-- Статус пользователя / Авторизация -->
  <% if user_signed_in? %>
    <!-- Компактный виджет профиля -->
    <div class="user-profile-badge d-flex align-items-center gap-2 bg-light p-1 pe-2 rounded-pill border">
      <%= image_tag current_user.avatar_tumbnail, class: "avatar rounded-circle border border-white shadow-sm", size: "32x32" %>
      <span class="fw-bold text-dark fs-6 px-1"><%= current_user.username %></span>
      
      <!-- Настройки -->
      <%= link_to edit_user_registration_path, class: "btn-icon-soft", title: t('menu.edit_account') do %>
        <i class="bi bi-gear-fill"></i>
      <% end %>

      <!-- Выход -->
      <%= link_to destroy_user_session_path(locale: I18n.locale), data: { turbo_method: :delete }, class: "btn-auth-logout", title: t('menu.sign_out') do %>
        <i class="bi bi-box-arrow-right"></i>
      <% end %>
    </div>
  <% else %>
    <!-- Градиентная кнопка входа -->
    <%= link_to new_user_session_path(locale: I18n.locale), class: "btn-auth-login" do %>
      <i class="bi bi-box-arrow-in-right me-2"></i>
      <span><%= t('menu.sign_in') %></span>
    <% end %>
  <% end %>

</div>
      </div>
    </nav>
  </div>
</header>

<!-- Side panel (offcanvas) for mobile -->
<!--/////////////////////////////////////////////////////////////////////////-->
    <div class="offcanvas offcanvas-end text-bg-white" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel"><%= t('.menu') %></h5>
        <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
       
        <!-- User profile or login/logout Mobil-->
  <ul class="nav col-12 col-lg-auto mb-2 mb-md-0 px-3">
  <li>
    <% if user_signed_in? %>
      <div class="d-flex align-items-center gap-2">
        <%= image_tag current_user.avatar_tumbnail, class: "avatar rounded-circle", size: "40x40" %>
        <strong><%= current_user.username %></strong>
        <%= link_to edit_user_registration_path,
            class: "btn btn-dark btn-sm shadow d-flex align-items-center px-3 py-1",
            style: "font-size:0.97rem; line-height:1.0; min-height:31px;" do %>
            <i class="bi bi-person-gear fs-5"></i>
           <%= t('menu.edit_account') %>
           <% end %>
      </div>
      <br>
    <%= link_to t('menu.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-sm bi bi-door-closed-fill mt-2" %>
    <% else %>
      <%= link_to t('menu.sign_in'), new_user_session_path, class: "btn btn-outline-primary btn-sm bi bi-door-closed-fill" %>
    <% end %>
  </li>
</ul>

      
            <div class="offcanvas-body">
  <ul class="navbar-nav flex-grow-1">
    <!-- Home -->
    <li class="nav-item mb-3">
      <%= link_to root_path,
          class: 'nav-link px-4 py-3 rounded-4 shadow-sm fw-semibold fs-5
                  d-flex align-items-center gap-3 bg-light text-dark
                  hover-shadow transition' do %>
        <i class="bi bi-house-door fs-4 text-primary"></i>
        <span><%= t('menu.home') %></span>
      <% end %>
    </li>

    <!-- Articles -->
    <li class="nav-item mb-3">
      <%= link_to articles_path,
          class: 'nav-link px-4 py-3 rounded-4 shadow-sm fw-semibold fs-5
                  d-flex align-items-center gap-3 bg-light text-dark
                  hover-shadow transition' do %>
        <i class="bi bi-journals fs-4 text-primary"></i>
        <span><%= t('menu.articles') %></span>
      <% end %>
    </li>

    <!-- Portfolio -->
    <li class="nav-item mb-3">
      <%= link_to portfolio_path,
          class: 'nav-link px-4 py-3 rounded-4 shadow-sm fw-semibold fs-5
                  d-flex align-items-center gap-3 bg-light text-dark
                  hover-shadow transition' do %>
        <i class="bi bi-briefcase fs-4 text-primary"></i>
        <span><%= t('menu.portfolio') %></span>
      <% end %>
    </li>

<!-- Manuscript -->
<li class="nav-item mb-3">
  <%= link_to manuscripts_path,
      class: 'nav-link px-4 py-3 rounded-4 shadow-sm fw-semibold fs-5
              d-flex align-items-center gap-3 bg-light text-dark
              hover-shadow transition' do %>
   <i class="bi bi-journal-richtext fs-4 text-primary"></i> 
    <span><%= t('menu.manuscripts') %></span>
  <% end %>
</li>
 
 <!-- Gallery -->
<li class="nav-item mb-3">
  <%= link_to gallery_path,
      class: 'nav-link px-4 py-3 rounded-4 shadow-sm fw-semibold fs-5
              d-flex align-items-center gap-3 bg-light text-dark
              hover-shadow transition' do %>
     <i class="bi bi-images fs-4 text-primary"></i>
    <span><%= t('menu.gallery') %></span>
  <% end %>
</li>
          <!-- Contacts link -->
          <!--li class="nav-item">
            <%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-3 text-dark bi bi-tencent-qq' %>
          </li-->
          <!-- Admin link (if authorized) -->
          <% if policy([:user]).index? %>
            <li class="nav-item">
              <%= link_to t('menu.admin'), admin_users_path, class: 'nav-link px-3 text-dark' %>
            </li>
          <% end %>
           <li>
              <%#= link_to "Edit Accunt", edit_user_registration_path, class: 'nav-link px-3 text-dark'%>
          </li>
        </ul>

                    <!Podkluchenie Jazykow >
        <div class="mt-3 px-3">
  <div class="dropdown">
    <%= link_to '#', class: 'btn btn-light dropdown-toggle w-100 d-flex align-items-center justify-content-center',
        data: { "bs-toggle": 'dropdown' } do %>
      <%= image_tag("flags/#{I18n.locale}.svg", alt: I18n.locale, width: 20, height: 15, class: "me-2") %>
      <%= t I18n.locale %>
    <% end %>
    
    <ul class="dropdown-menu w-100">
      <% I18n.available_locales.each do |locale| %>
        <% unless I18n.locale == locale %>
          <li>
            <%= link_to url_for(locale: locale), data: { turbo: false },
                class: "dropdown-item d-flex align-items-center" do %>
              <%= image_tag("flags/#{locale}.svg", alt: locale, width: 20, height: 15, class: "me-2") %>
              <%= t(locale) %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>
      
      
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="container mt-3">
    <% flash.each do |key, value| %>
       <div class="container mt-4">
       <div class="alert alert-<%= key == 'notice' ? 'success' : 'danger' %> text-center shadow">
        <%= value %>
       </div>
       </div>
    <% end %>
   <%= yield %>
  </main>

</body>

</html>


