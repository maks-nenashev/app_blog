<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= full_title(yield(:page_title)) %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Styles -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "home", "articles", "devise", "tweets", "data-turbo-track": "reload" %>

    <!-- Scripts -->
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag "home.js", "articles.js", "devise.js", "tweets.js", "data-turbo-track": "reload" %>

</head>

<body>
  <div class="container mt-3">
    <!-- Header -->
    <header class="p-1 bg-white">
      <div class="container-fluid">
        <nav class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start navbar navbar-bg-dark">
          <h2 class="navbar-brand" href="#">Tutorial Project</h2>
          <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>

          <!-- Navbar menu -->
          <ul class="nav col-12 col-lg-auto mb-2 justify-content-center mb-md-0">
            <li><%= link_to t('menu.home'), root_path, class: 'nav-link px-2 text-dark' %></li>
            <li><%= link_to t('menu.articles'), articles_path, class: 'nav-link px-2 text-dark' %></li>
            <li><%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-2 text-white' %></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Side panel (offcanvas) for mobile -->
    <div class="offcanvas offcanvas-end text-bg-white" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">Меню</h5>
        <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
       
        <!-- User profile or login/logout -->
        <ul class="nav col-12 col-lg-auto mb-2 mb-md-0 px-3">
          <li>
            <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-2"> <!All one line>
            <%= image_tag current_user.avatar_tumbnail, class: "avatar rounded-circle", size: "40x40" %>
        <strong><%= current_user.username %></strong>
            <%= link_to "Edit Account", edit_user_registration_path, class: 'nav-link px-2 text-dark' %>
        </div> 
             <br>
              <%= link_to t('menu.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-sm bi bi-door-closed-fill" %>
            <% else %>
              <%= link_to t('menu.sign_in'), new_user_session_path, class: "btn btn-outline-primary btn-sm bi bi-door-open-fill" %>
            <% end %>
          </li>
        </ul>
      
      
      <div class="offcanvas-body">
        <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
          <!-- Home link -->
          <li class="nav-item">
            <%= link_to t('menu.home'), root_path, class: 'nav-link px-3 text-dark bi bi-house-door' %>
          </li>
          <!-- Articles link -->
          <li class="nav-item">
            <%= link_to t('menu.articles'), articles_path, class: 'nav-link px-3 text-dark bi bi-journals' %>
          </li>
          <!-- Contacts link -->
          <li class="nav-item">
            <%= link_to t('menu.contacts'), new_contacts_path, class: 'nav-link px-3 text-dark bi bi-tencent-qq' %>
          </li>
          <!-- Admin link (if authorized) -->
          <% if policy([:user]).index? %>
            <li class="nav-item">
              <%= link_to t('menu.admin'), admin_users_path, class: 'nav-link px-3 text-dark' %>
            </li>
          <% end %>
           <li>
              <%#= link_to "Edit Accunt", edit_user_registration_path, class: 'nav-link px-3 text-dark'%>
          </li>
        </ul>

                    <!Podkluchenie Jazykow >
            <ul class="nav col-12 col-lg-auto mb-2 mb-md-0">
          <li class="dropdown">
            <%= link_to '#', class: 'nav-link px-4',
              data: {"bs-toggle": 'dropdown'} do %>
              <%= tag.div '', class: "flag #{I18n.locale}-flag mt-1 bi bi-globe" %>
              <%= t I18n.locale %>
            <% end %>
            
            <ul class="dropdown-menu dropdown-menu-dark">
              <% I18n.available_locales.each do |locale| %>
                <li>
                  <% if I18n.locale == locale %>
                    <%= tag.span t(locale), class: 'dropdown-item' %>
                  <% else %>
                    <%= link_to t(locale), url_for(locale: locale),
                      class: 'dropdown-item' %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>
        </ul> 
      
      
      </div>
    </div>
  </div>

  <!-- Custom CSS for body font and size -->
  <style>
    body {
      font-family: 'Sofia';
      font-size: 22px;
    }
  </style>

  <!-- Main Content -->
  <main class="container mt-3">
    <% flash.each do |k, v| %>
      <%= tag.div v, class: "alert alert-#{k}", role: 'alert' %>
    <% end %>
    <%= yield %>
  </main>

  <!-- Notices and Alerts -->
  <p class="notice"><%= notice %></p>
  <p class="alert"><%= alert %></p>

  <!-- Bootstrap JS -->
  <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js", defer: true %>
</body>

</html>
