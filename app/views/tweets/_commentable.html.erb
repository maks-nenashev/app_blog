<% is_current_tweet = tweet&.for?(commentable) %>
<% tweet_builder = is_current_tweet ? tweet : commentable.tweets.build %>

<div class="d-flex justify-content-center mb-4">
  <!-- Кнопка для раскрытия формы -->
  <% button_color = local_assigns[:button_color] || 'rgb(192, 166, 20)' %>
  <% button_text_color = local_assigns[:button_text_color] || '#000' %>
  <% button_border_color = local_assigns[:button_border_color] || '#FFD700' %>

  <%= link_to t('.button'), "##{html_id}",
              class: 'btn btn-sm shadow-lg fw-semibold',
              style: "background-color: #{button_color}; color: #{button_text_color}; border-color: #{button_border_color}; width: 400px; text-align: center;",
              data: { 'bs-toggle': 'collapse', 'bs-target': "##{html_id}" },
              aria: { expanded: is_current_tweet ? 'true' : 'false', controls: html_id } %>
</div>

<%= tag.div class: "collapse #{'show' if is_current_tweet} bg-white shadow-lg rounded p-4", id: html_id do %>
  <% if policy(tweet_builder).create? %>
    <!-- Форма добавления комментария -->
    <%= form_with model: [commentable, tweet_builder], class: 'pt-3' do |f| %>
      <!-- Ошибки -->
      <% if is_current_tweet %>
        <div class="shadow-sm p-2 bg-light rounded">
          <%= render 'shared/errors', object: tweet %>
        </div>
      <% end %>

      <!-- Поле для текста -->
      <div class="mb-3 shadow-sm p-3 bg-light rounded">
        <%= f.label :body, t(".your_comment_title"), class: "form-label fw-semibold text-muted" %>
        <%= f.text_area :body, class: 'form-control shadow-sm rounded', rows: 3, placeholder: t(".enter_text_placeh") %>
      </div>

      <!-- Кнопка отправки -->
      <div class="d-flex justify-content-end">
        <%= f.submit t('.comment_button'), class: 'btn btn-success btn-sm fw-semibold shadow-lg' %>
      </div>
    <% end %>
  <% end %>

  <!-- Список комментариев -->
  <div class="mt-4 shadow-sm p-3 bg-light rounded">
    <h5 class="fw-bold text-secondary"><%= t(".comment_title") %></h5>
    <%= render commentable.tweets.decorate %>
  </div>
<% end %>