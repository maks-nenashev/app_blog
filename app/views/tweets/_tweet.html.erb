<%= tag.article class: 'mb-4 card shadow-lg border-0', id: dom_id(tweet) do %>
  <div class="row g-0">
    <!-- Левая колонка: Аватар и информация о пользователе -->
    <div class="col-12 col-sm-3 text-center p-3">
      <section class="d-flex flex-column align-items-center">
        <!-- Аватар пользователя -->
        <%= image_tag tweet.user.avatar_tumbnail, class: "avatar rounded-circle mb-2", alt: "#{tweet.user.username}'s avatar" %>
        <h5 class="mb-1 text-truncate"><%= tweet.user.username %></h5>

        <!-- Время создания -->
        <time datetime="<%= tweet.created_at.strftime('%Y-%m-%d %H:%M:%S') %>" class="text-muted small">
          <%= tweet.created_at.strftime('%d %b %Y, %H:%M') %>
        </time>
      </section>
    </div>

    <!-- Правая колонка: Текст комментария -->
    <div class="col-12 col-sm-9">
      <div class="card-body">
        <!-- Кнопки управления (Edit/Delete) -->
        <div class="d-flex justify-content-end mb-2">
          <% if policy(tweet).edit? %>
            <%= link_to t('.edit_comment'), edit_polymorphic_path([tweet.commentable, tweet]),
                        class: 'btn btn-outline-secondary btn-sm bi bi-pencil-square me-2' %>
          <% end %>
          <% if policy(tweet).destroy? %>
            <%= link_to t('.delete_comment'), polymorphic_path([tweet.commentable, tweet]),
                        class: 'btn btn-outline-danger btn-sm bi bi-trash3-fill',
                        data: { turbo_method: :delete, confirm: 'Are you sure?' } %>
          <% end %>
        </div>

        <!-- Текст комментария -->
        <h6 class="card-subtitle mb-2 text-muted"></h6>
        <p class="card-text fs-6">
          <%= sanitize tweet.body, tags: %w(strong em a p br ul ol li), attributes: %w(href title) %>
        </p>
      </div>
    </div>
  </div>
<% end %>