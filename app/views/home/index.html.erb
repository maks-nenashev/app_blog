<% provide :page_title, 'Home' %> <!Podpis w ikonke "Kakaja stranica">

<h1 class="text-center animate__animated animate__fadeInDown display-4 fw-bold my-5" style="font-family: 'Aboreto', cursive; color: #333;">
   Where ideas come to life 
</h1>

<!--div class="divider"><!h1><%= t('home.index.title').html_safe %><!/h1><!/div-->

<div class="container py-5">
  <div class="row justify-content-center align-items-center g-5">
    
     <!--Photo and ramka-->
     <div class="col-md-4 text-center">
          <%= image_tag "mn.jpg",
          id: "myImg",
          alt: "Maksym Nenashev",
          class: "img-fluid rounded shadow-lg",
          style: "max-width:350px; border: 4px solid rgba(255,255,255,0.8); box-shadow: 0 6px 24px rgba(0,0,0,0.16);" %>
     </div>


    <!-- Текст -->
    <div class="col-md-7">
      <h2 class="fw-bold mb-3"></h2>
      <p class="lead" style="text-align: justify;">
        <%= t('home.index.little_about_me').html_safe %>
      </p>
      
      <!-- Кнопки -->
<div class="d-flex flex-column flex-md-row gap-3 mt-4 align-items-center align-items-md-start text-center text-md-start">
  <a href="https://github.com/maks-nenashev" target="_blank" class="btn btn-dark shadow-sm">
    <i class="bi bi-github"></i> GitHub
  </a>
  <a href="https://www.linkedin.com/in/maksym-nenashev-0627ab220/" target="_blank" class="btn btn-primary shadow-sm">
    <i class="bi bi-linkedin"></i> LinkedIn
  </a>
  <span class="fw-bold fs-5" style="font-family: monospace;">
    <i class="bi bi-envelope-fill text-success me-2"></i>
    maksym@nenashev.net
  </span>
</div>


       <!--button type="button" class="btn btn-primary bi bi-github" onClick='location.href="https://github.com/maks-nenashev"'></button-->
      </div>
    </div>

  </div>
</div>

<!-- The Modal -->
<div id="myModal" class="modal">
  <span class="close">&times;</span>
  <img class="modal-content" id="img01">
  <div id="caption"></div>
</div>
