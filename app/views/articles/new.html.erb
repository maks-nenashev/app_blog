<% provide :page_title, 'New Articles' %>

<div class="container my-5">
  <!-- Заголовок страницы -->
  <div class="text-center mb-4">
    <h2 class="fw-bold"><%= t('.title') %></h2>
  </div>

  <!-- Форма создания статьи -->
  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_for :article, url: articles_path, data: { turbo: false } do |f| %>

        <!-- Отображение ошибок -->
        <%= render 'shared/errors', object: @article %>

        <!-- Заголовок статьи -->
        <div class="mb-3">
          <%= f.label :title, class: "form-label fw-semibold" %>
          <%= f.text_field :title, placeholder: "Enter title", class: "form-control", required: true, minlength: 2 %>
        </div>

        <!-- Текст статьи -->
        <div class="mb-3">
          <%= f.label :text, class: "form-label fw-semibold" %>
          <%= f.text_area :text, placeholder: "Enter text", class: "form-control", rows: 6, required: true, minlength: 2 %>
        </div>

        <!-- Загрузка изображения -->
        <div class="mb-4">
          <%= f.label :image, class: "form-label fw-semibold" %><br>
          <%= f.file_field :image, class: "form-control" %>
        </div>

        <!-- Кнопка отправки -->
        <div class="d-grid">
          <%= f.submit t('.submit_article'), class: "btn btn-primary btn-lg shadow-sm" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
