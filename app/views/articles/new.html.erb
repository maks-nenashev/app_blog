<% provide :page_title, 'New Articles' %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="card shadow-lg border-0 rounded-4 p-4 bg-white">
        <!-- Заголовок страницы -->
        <h2 class="text-center mb-4 text-primary fw-bold">
          <%= t('.title') %>
        </h2>

        <%= form_for :article, url: articles_path, html: { multipart: true }, data: { turbo: false } do |f| %>
          <!-- Отображение ошибок -->
          <%= render 'shared/errors', object: @article %>

          <!-- Заголовок статьи -->
          <div class="mb-3">
            <%= f.label :title, t(".title_art"), class: "form-label fw-semibold" %>
            <%= f.text_field :title, placeholder: t(".place_title"), class: "form-control shadow-sm", required: true, minlength: 2 %>
          </div>

          <!-- Текст статьи -->
          <div class="mb-3">
            <%= f.label :text, t(".text_art"), class: "form-label fw-semibold" %>
            <%= f.text_area :text, placeholder: t(".place_text"), class: "form-control shadow-sm", rows: 6, required: true, minlength: 2 %>
          </div>

          <!-- Загрузка изображения -->
          <div class="mb-3">
           <label class="btn btn-dark">
           <%= t(".button") %>
             <%= f.file_field :images, multiple: true, style: "display: none;" %>
            </label>
          </div>

          <!-- Кнопка отправки -->
          <div class="d-grid mt-4">
            <%= f.submit t('.submit_article', default: "Создать статью"), class: "btn btn-success btn-lg shadow" %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</section>