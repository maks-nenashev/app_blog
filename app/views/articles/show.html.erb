<% provide :page_title, 'Article has been created!!!' %> <!Podpis w ikonke "Kakaja stranica">

     <!3 Wywodim bazy po ID>
<section class="card-header">
      <!h3><!%= t'.thanks'%><!/h3>
      <h4><%= image_tag @article.user.avatar_tumbnail, class: "avatar"%>
          <%= @article.user.username%></h4>  <!Connect "usera!!">
      <h4><!%= t'.create'%></h4>
</section>

              <!Podkluchenie time pod soobzheniem!>
  <time datetime="<%= @article.created_at.strftime("%Y-%m-%d %H:%M:%S")%>">
  <%= @article.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
  </time>  
     
     <% if policy(@article).edit?%> <! Podkluchenie Авторизация (Pundit)>
   <%= link_to t('.edit_article'), edit_article_path(@article),class: "btn btn-secondary btn-sm bi bi-pencil-square"%> 
      <%end%>
      <% if policy(@article).destroy?%> <! Podkluchenie Авторизация (Pundit)>
   <%= link_to t('.delete_article'), article_path(@article), data: {'turbo-method': :delete,'turbo-confirm': 
     'Are you sure?'}, class:"btn btn-danger btn-sm bi bi-trash3-fill"%>
      <%end%>
  <hr>
  <h4><%= @article.title %></h4> 
<p>
<% if @article.image.attached?%> <! if image nil>
<%= image_tag @article.image, style: "width: 380px; height: auto", id:"myImg", alt:"Image", class: 'img-thumbnail thumb'%>
 <% end %>

  <%= @article.text %></p>
 
 <!-- The Modal -->
<div id="myModal" class="modal">
  <span class="close">&times;</span>
  <img class="modal-content" id="img01">
  <div id="caption"></div>
</div>
     
     <br> <!br>               <!Dobawlenie okna>
   <%= render 'tweets/commentable', commentable: @article, tweet: @tweet,  
     html_id: 'articleTweets' %>
   
<!/////////////////////////////////////////////////////////////////////////////////////////>
 <!-- Статья и комментарии -->
<h4 class="mt-5"><%= t('.topic') %></h4>
<%= link_to t('.new_comment'), new_article_comment_path(@article), class: "btn btn-primary my-3" %>

<%= pagination @pagy %>

<br>
<% @comments.each do |comment| %>
  <article class="mb-3 card">
    <div class="card-body">

      <section class="card-header">
        <h4>
          <%= image_tag comment.user.avatar_tumbnail, class: "avatar" %>
          <%= comment.user.username %>
        </h4>

        <time datetime="<%= comment.created_at.strftime("%Y-%m-%d %H:%M:%S") %>">
          <%= comment.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
        </time>
      </section>

      <h4><%= link_to comment.title, article_comment_path(@article, comment)%></h4>

      <% if comment.image.attached? %>
        <%= link_to image_tag(comment.image, style: "width: 380px; height: auto", class: 'img-thumbnail thumb'), article_comment_path(@article, comment) %>
        <%#=  image_tag comment.image, style: "width: 380px; height: auto", class: 'img-thumbnail thumb' %>
      <% end %>

      <h4><%= comment.body %></h4>

      <%# if policy(comment).edit? %>
        <%#= link_to t('.edit_comment'), edit_article_comment_path(@article, comment), class: "btn btn-secondary btn-sm bi bi-pencil-square" %> 
      <%# end %>

      <%# if policy(comment).destroy? %>
        <%#= link_to t('.delete_comment'), article_comment_path(@article, comment), data: { method: :delete, confirm: "Are you sure?" }, class: "btn btn-danger btn-sm bi bi-trash3-fill" %>
      <%# end %>

      <br><br>

      <%#= render 'tweets/commentable', commentable: comment, tweet: @tweet, html_id: dom_id(comment, 'tweet_form') %>

    </div>
  </article>
<% end %>
