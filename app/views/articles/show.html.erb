<% provide :page_title, @article.title %>

<div class="container my-5">
  <!-- Шапка статьи -->
  <header class="mb-5 max-w-900 mx-auto">
    <h1 class="h3 fw-bold mb-4 text-break text-center" style="color: #027dfd;"><%= @article.title %></h1>

    <!-- Главный медиа-блок -->
    <div class="d-flex flex-column flex-md-row justify-content-center align-items-start gap-3 mb-3">
      <!-- Основное изображение / Аватар -->
      <div class="w-100 shadow-sm rounded-4 bg-white p-2 border overflow-hidden position-relative" style="max-width: 680px;">
        <% if @article.images.attached? %>
          <div class="position-relative overflow-hidden rounded-3 group-zoom">
            <img id="main-image"
                 src="<%= url_for(@article.images.first.variant(resize_to_limit: [720, 400])) %>"
                 data-full-url="<%= url_for(@article.images.first) %>"
                 class="img-fluid rounded-3 w-100 object-fit-cover cursor-pointer"
                 style="max-height: 420px; transition: transform 0.3s ease;"
                 alt="<%= @article.title %>"
                 onclick="openArticleLightbox(this.dataset.fullUrl)">
            
            <!-- Бейдж-подсказка при наведении -->
            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-3 px-3 py-2 rounded-pill text-white pointer-events-none">
              <i class="bi bi-zoom-in me-1"></i> <%= t('.click_to_zoom', default: 'Increase') %>
            </span>
          </div>
        <% else %>
          <div class="text-center py-4">
            <%= image_tag @article.user.avatar_tumbnail,
                        class: "rounded-circle shadow-sm",
                        size: "140x140",
                        alt: @article.user.username %>
          </div>
        <% end %>

        <!-- Миниатюры для мобильных (под основным фото) -->
        <% if @article.images.size > 1 %>
          <div class="d-flex flex-row gap-2 mt-2 d-md-none justify-content-center overflow-auto py-1">
            <% @article.images.each_with_index do |img, i| %>
              <%= image_tag img.variant(resize_to_limit: [90, 90]),
                class: "img-thumbnail rounded-3 border preview-image #{'border-primary border-2' if i == 0}",
                style: "width:75px; height:75px; object-fit:cover; cursor:pointer;",
                alt: "Mini image #{i+1}",
                data: { 
                  large: url_for(img.variant(resize_to_limit: [720, 400])),
                  full_url: url_for(img)
                } %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Миниатюры для Desktop (справа от основного фото) -->
      <% if @article.images.size > 1 %>
        <div class="d-none d-md-flex flex-column gap-2">
          <% @article.images.each_with_index do |img, i| %>
            <%= image_tag img.variant(resize_to_limit: [90, 90]),
              class: "img-thumbnail rounded-3 border preview-image shadow-sm #{'border-primary border-2' if i == 0}",
              style: "width:80px; height:80px; object-fit:cover; cursor:pointer;",
              alt: "Mini image #{i+1}",
              data: { 
                large: url_for(img.variant(resize_to_limit: [720, 400])),
                full_url: url_for(img)
              } %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Метаданные автора -->
    <div class="d-flex align-items-center gap-3 max-w-680 mx-auto px-1">
      <%= image_tag @article.user.avatar_tumbnail, class: "rounded-circle border border-2 border-primary-subtle", width: 44, height: 44 %>
      <div class="small">
        <div class="fw-bold text-dark"><%= @article.user.username %></div>
        <div class="text-muted" style="font-size: 0.825rem;">
          <%= t('.create') %>
          <time datetime="<%= @article.created_at.iso8601 %>"><%= l(@article.created_at, format: :short) %></time>
        </div>
      </div>
    </div>
  </header>

  <!-- Основной текст статьи -->
  <article class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
    <div class="fs-5 text-start" style="line-height: 1.8; color: #2c3e50;">
      <%= simple_format(@article.text) %>
    </div>
  </article>

  <!-- Панель управления статьей -->
  <div class="mb-5 d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-4">
    <div class="d-flex gap-2">
      <% if policy(@article).edit? %>
        <%= link_to edit_article_path(@article), class: "btn btn-sm btn-outline-primary rounded-pill px-3" do %>
          <i class="bi bi-pencil-square me-1"></i> <%= t('.edit_article') %>
        <% end %>
      <% end %>
      <% if policy(@article).destroy? %>
        <%= link_to article_path(@article),
                    data: { 'turbo-method': :delete, 'turbo-confirm': t('.are_you_sure') },
                    class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
          <i class="bi bi-trash3-fill me-1"></i> <%= t('.delete_article') %>
        <% end %>
      <% end %>
    </div>
    <%= link_to articles_path, class: "btn btn-sm btn-light text-secondary border rounded-pill px-3" do %>
      <i class="bi bi-arrow-left me-1"></i> <%= t('.back_to_all_articles') %>
    <% end %>
  </div>

  <!-- Виджет комментариев / реплик -->
  <%= render 'tweets/commentable', commentable: @article, tweet: @tweet, html_id: 'articleTweets' %>

  <!-- Секция тем и обсуждений -->
  <section class="mt-5 pt-3">
    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-chat-square-text-fill text-primary fs-4"></i>
        <h3 class="h4 fw-bold m-0"><%= t('.topic') %></h3>
      </div>

      <!-- Кастомная CTA-кнопка "Новая тема" -->
      <%= link_to new_article_comment_path(@article), 
                  class: "btn btn-cta-topic rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" do %>
        <i class="bi bi-plus-circle-fill fs-5"></i>
        <span><%= t('.new_topic') %></span>
      <% end %>
    </div>

    <!-- Сетка карточек обсуждений -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @comments.each do |comment| %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 hover-card transition-all bg-white">
            <div class="card-body d-flex flex-column p-4">
              <!-- Автор и дата -->
              <div class="d-flex align-items-center gap-2 mb-3">
                <%= image_tag comment.user.avatar_tumbnail, class: "rounded-circle border", width: 42, height: 42 %>
                <div class="d-flex flex-column">
                  <span class="fw-bold fs-6 text-dark lh-sm"><%= comment.user.username %></span>
                  <small class="text-muted mt-1" style="font-size: 0.75rem;">
                    <%= l(comment.created_at, format: :short) %>
                  </small>
                </div>
              </div>

              <!-- Заголовок -->
              <h5 class="card-title fw-bold mb-3 fs-6">
                <%= link_to comment.title, article_comment_path(@article, comment), class: "text-dark text-decoration-none hover-primary" %>
              </h5>

              <!-- Изображение комментария -->
              <% if comment.images.attached? %>
                <div class="mb-3 rounded-3 overflow-hidden" style="height: 180px;">
                  <%= link_to article_comment_path(@article, comment) do %>
                    <%= image_tag comment.images.first.variant(resize_to_limit: [600, 300]),
                        class: "w-100 h-100 object-fit-cover",
                        alt: "Comment image" %>
                  <% end %>
                </div>
              <% end %>

              <!-- Текст -->
              <p class="card-text text-secondary small mb-0 flex-grow-1">
                <%= truncate(strip_tags(comment.body), length: 140) %>
              </p>
            </div>

            <!-- Футер карточки -->
            <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
              <%= link_to article_comment_path(@article, comment), class: "small fw-semibold text-primary text-decoration-none d-inline-flex align-items-center gap-1" do %>
                <span><%= t('.read_more', default: 'Read more') %></span>
                <i class="bi bi-chevron-right small"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Центрированная пагинация -->
    <div class="d-flex justify-content-center mt-5">
      <%= pagination @pagy if defined?(@pagy) %>
    </div>
  </section>
</div>

<!-- Lightbox Modal (Увеличение полноразмерного фото) -->
<dialog id="articleImageLightbox" class="p-0 border-0 rounded-4 shadow-lg overflow-hidden" onclick="if(event.target === this) closeArticleLightbox();">
  <div class="position-relative bg-dark p-3 d-flex flex-column align-items-center">
    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" onclick="closeArticleLightbox()"></button>
    <img id="articleLightboxImg" src="" alt="Full view" style="max-height: 85vh; max-width: 90vw; object-fit: contain; border-radius: 12px;">
  </div>
</dialog>

<style>
  .max-w-900 { max-width: 900px; }
  .max-w-680 { max-width: 680px; }
  .cursor-pointer { cursor: pointer; }
  .pointer-events-none { pointer-events: none; }

  /* Эффект зума для основного фото и картинок комментариев */
  #main-image:hover, .hover-zoom:hover {
    transform: scale(1.02);
  }

  #articleImageLightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  /* Градиентная кнопка создания темы */
  .btn-cta-topic {
    background: linear-gradient(135deg, #027dfd 0%, #0056b3 100%);
    color: #ffffff;
    border: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-cta-topic:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(2, 125, 253, 0.35) !important;
  }

  /* Эффекты карточек */
  .hover-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    border: 1px solid rgba(0,0,0,0.05) !important;
  }
  .hover-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
  }

  .hover-primary {
    transition: color 0.15s ease;
  }
  .hover-primary:hover {
    color: #027dfd !important;
  }
</style>

<script>
  document.addEventListener("turbo:load", function() {
    initArticleGallery();
  });

  // Фолбэк для обычной DOM-загрузки
  document.addEventListener("DOMContentLoaded", function() {
    initArticleGallery();
  });

  function initArticleGallery() {
    const mainImg = document.getElementById('main-image');
    const previews = document.querySelectorAll('.preview-image');

    previews.forEach(preview => {
      preview.addEventListener('click', function() {
        if (!mainImg) return;
        
        // Меняем превью главного фото и URL для полноэкранного зума
        mainImg.src = this.dataset.large;
        mainImg.dataset.fullUrl = this.dataset.fullUrl;

        // Переключаем выделение синей рамкой активной миниатюры
        previews.forEach(p => p.classList.remove('border-primary', 'border-2'));
        this.classList.add('border-primary', 'border-2');
      });
    });
  }

  window.openArticleLightbox = function(url) {
    const dialog = document.getElementById('articleImageLightbox');
    const lightboxImg = document.getElementById('articleLightboxImg');
    if (dialog && lightboxImg && url) {
      lightboxImg.src = url;
      dialog.showModal();
    }
  };

  window.closeArticleLightbox = function() {
    const dialog = document.getElementById('articleImageLightbox');
    if (dialog) dialog.close();
  };
</script>