<% provide :page_title, @article.title %>

<div class="container my-5">
  <!-- Заголовок и автор -->
 
 <header class="mb-4">
    <h1 class="h4 fw-bold mb-4 text-break text-center"><%= @article.title %></h1>

    <% if @article.image.attached? %>
      <div class="mx-auto" style="max-width: 720px;">
        <!-- Фото -->
        <div class="text-center mb-3">
          <%= image_tag @article.image, class: "img-fluid rounded shadow-sm w-100", alt: "Article image" %>
        </div>

        <!-- Автор под фото, адаптивный -->
        <div class="d-flex flex-column flex-md-row align-items-start gap-2 px-2">
          <%= image_tag @article.user.avatar_tumbnail, class: "rounded-circle", width: 40, height: 40 %>
          <div class="small text-start">
            <strong><%= @article.user.username %></strong><br>
            <span class="text-muted">
              <%= t('.create') %>
              <time datetime="<%= @article.created_at.iso8601 %>">
                <%= l(@article.created_at, format: :short) %>
              </time>
            </span>
          </div>
        </div>
      </div>
    <% end %>
  </header>

<!-- Текст статьи -->
  <div class="mb-5 fs-6 text-center px-2 px-md-5">
    <%= simple_format(@article.text) %>
  </div>

  <!-- Кнопки редактирования -->
  <div class="mb-4 d-flex flex-wrap gap-2">
    <% if policy(@article).edit? %>
      <%= link_to edit_article_path(@article), class: "btn btn-outline-primary" do %>
        <i class="bi bi-pencil-square me-1"></i> <%= t('.edit_article') %>
      <% end %>
    <% end %>

    <% if policy(@article).destroy? %>
      <%= link_to article_path(@article),
                  data: { 'turbo-method': :delete, 'turbo-confirm': t('.are_you_sure') },
                  class: "btn btn-outline-danger" do %>
        <i class="bi bi-trash3-fill me-1"></i> <%= t('.delete_article') %>
      <% end %>
    <% end %>
  </div>

  <!-- Виджет комментариев -->
  <%= render 'tweets/commentable', commentable: @article, tweet: @tweet, html_id: 'articleTweets' %>

 <!hr class="my-5 border-top border-warning" style="border-width: 65px;" />
 <div class="divider"><h1><%= t('.topic') %></h1></div>
  <br>
  
  <!-- Комментарии -->
  <section>
    <%= link_to t('.new_topic'), new_article_comment_path(@article), class: "btn btn-primary mb-4" %>
    
    <%= pagination @pagy %>

    <% @comments.each do |comment| %>
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center">
              <%= image_tag comment.user.avatar_tumbnail, class: "rounded-circle me-2", width: 40, height: 40 %>
              <strong><%= comment.user.username %></strong>
            </div>
            <small class="text-muted">
              <time datetime="<%= comment.created_at.iso8601 %>">
                <%= l(comment.created_at, format: :short) %>
              </time>
            </small>
          </div>

          <h5 class="card-title"><%= link_to comment.title, article_comment_path(@article, comment), class: "text-decoration-none" %></h5>

          <% if comment.image.attached? %>
            <div class="mb-3">
              <%= link_to image_tag(comment.image, class: "img-fluid rounded"), article_comment_path(@article, comment) %>
            </div>
          <% end %>

          <p class="card-text"><%= simple_format(comment.body) %></p>
        </div>
      </div>
    <% end %>
  </section>
</div>
