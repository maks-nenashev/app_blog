<% provide :page_title, 'Articles' %> <!Podpis w ikonre "Kakaja stranica">
<!% currently_art "Articles" %>
              
<h2 class="mb-4"><%= t'.title'%></h2>  <!# Wywod wsech zapisej!>
<p>         <!Button>
    <% if policy(:article).new?%> <! Podkluchenie Авторизация (Pundit)>
  <%= link_to t('.new'), new_article_path,class: "btn btn-outline-primary bi bi-pencil-square" %>
  <!%= link_to t('.new'), new_article_path, class:"button2"%>   
  <%#= link_to t('.new'), new_article_path, class: "button big bi bi-pencil-square"%>
    <%end%>
 <!/p>
<%= pagination @pagy %>   <!Pagy "gem pagy" razbiw na stranicy Podkluchenie>
</p>
 <div class="row">
  <div class="column">
<% @articles.each do |article| %>
     
      <h4><%= image_tag article.user.avatar_tumbnail, class: "avatar"%>
          <%= article.user.username%></h4>  <!Connect "usera!!">
      
  <div class="card-body">

                   <! Podkluchenie time pod soobzheniem!>
  <!time datetime="<%#= article.created_at.strftime("%Y-%m-%d %H:%M:%S")%>">
  <%#= article.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
  <!/time>  
        <!br>   <!/section> 
     <!%= link_to t('.show_article'), article_path(article),class: "btn btn-outline-primary btn-sm"%>  
         <!% if policy(article).edit?%> <! Podkluchenie Авторизация (Pundit)>
     <!%= link_to t('.edit_article'), edit_article_path(article),class: "btn btn-outline-secondary btn-sm bi bi-pencil-square"%> 
        <!%end%>
         <!% if policy(article).destroy?%> <! Podkluchenie Авторизация (Pundit)>
     <!%= link_to t('.delete_article'), article_path(article), data: {'turbo-method': :delete,'turbo-confirm': 
     'Are you sure?'}, class:"btn btn-outline-danger btn-sm bi bi-trash3-fill"%>
         <!%end%>    
       <!hr>
  
  <h5>
  <%= link_to article.title, article_path(article)%>
  </h5>
  
  <p class="my-2">
  <% if article.image.attached?%> <! if image nil>
  <%= link_to image_tag(article.image, style: "width: 380px; height: auto", class: 'img-thumbnail thumb'),article_path(article)%>
  <% end %>
  
  <%= article.text %>
  </p>             

    </div>      
  </div>
  <hr>
<% end %>
<br>
 <%= pagination @pagy %>  <!Pagy "gem pagy" razbiw na stranicy Podkluchenie>
 <br>

<style>
body {
    font-family: 'Sofia';font-size: 22px;
}
</style>