<% provide :page_title, 'Articles' %> <!-- Заголовок страницы -->

<section class="container py-5">
  <!-- Заголовок страницы -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold text-shadow"><%= t('.title', default: 'Articles') %></h2>
    <% if policy(:article).new? %>
      <%= link_to t('.new', default: 'New Article'), new_article_path, class: "btn btn-outline-primary bi bi-pencil-square shadow-sm" %>
    <% end %>
  </div>

  <!-- Пагинация сверху -->
  <div class="mb-4">
    <%= pagination @pagy %>
  </div>

  <!-- Список статей -->
  <% @articles.each do |article| %>
    <div class="card mb-4 shadow-lg rounded-4">
      <div class="row g-0">
        <!-- Изображение или аватар пользователя -->
        <div class="col-md-4 d-flex align-items-center justify-content-center bg-light shadow-sm">
          <% if article.image.attached? %>
            <%= link_to image_tag(article.image, class: "img-fluid rounded-start shadow-sm", alt: article.title), article_path(article) %>
          <% else %> <!--if you don't have a images this will be avatar-->
            <%= image_tag article.user.avatar_tumbnail, class: "rounded-circle shadow-sm", size: "150x150", alt: article.user.username %>
          <% end %>
        </div>

        <!-- Контент статьи -->
        <div class="col-md-8">
          <div class="card-body">
            <!-- Имя пользователя -->
            <h5 class="card-title d-flex align-items-center text-shadow">
              <%= image_tag article.user.avatar_tumbnail, class: "avatar rounded-circle me-2 shadow-sm", size: "40x40", alt: article.user.username %>
              <%= article.user.username %>
            </h5>

            <!-- Дата создания -->
            <p class="text-muted small mb-2">
              <i class="bi bi-clock"></i> <%= article.created_at.strftime("%d %B %Y, %H:%M") %>
            </p>

            <!-- Заголовок статьи -->
            <h4 class="fw-bold text-shadow">
              <%= link_to article.title, article_path(article), class: "text-dark text-decoration-none" %>
            </h4>

            <!-- Текст статьи -->
            <p class="card-text">
              <%= truncate(article.text, length: 150, separator: ' ') %>
            </p>

            <!-- Действия -->
            <div class="d-flex gap-2">
              <% if policy(article).edit? %>
                <%= link_to t('.edit_article', default: 'Edit'), edit_article_path(article), class: "btn btn-outline-secondary btn-sm bi bi-pencil-square shadow-sm" %>
              <% end %>
              <% if policy(article).destroy? %>
                <%= link_to t('.delete_article', default: 'Delete'), article_path(article), data: { 'turbo-method': :delete, 'turbo-confirm': t('.confirm_delete', default: 'Are you sure?') }, class: "btn btn-outline-danger btn-sm bi bi-trash3-fill shadow-sm" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>

  <!-- Пагинация снизу -->
  <div class="mt-4">
    <%= pagination @pagy %>
  </div>
</section>
