<% provide :page_title, 'Edit Article' %>

<section class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="card shadow-lg border-0 rounded-4 p-4 bg-white">
        <!-- Заголовок -->
        <h2 class="text-center mb-4 text-primary fw-bold">
          <%= t('.title', default: "Редактировать статью") %>
        </h2>

        <%= form_for :article, url: article_path(@article), method: :patch, html: { class: "needs-validation", novalidate: true } do |f| %>
          <!-- Ошибки -->
          <%= render 'shared/errors', object: @article %>

          <!-- Поле: Title -->
          <div class="mb-3">
            <%= f.label :title, "Заголовок статьи", class: "form-label fw-semibold" %>
            <%= f.text_field :title, placeholder: "Введите заголовок", class: "form-control shadow-sm", required: true, minlength: 2 %>
          </div>

          <!-- Поле: Text -->
          <div class="mb-3">
            <%= f.label :text, "Текст статьи", class: "form-label fw-semibold" %>
            <%= f.text_area :text, placeholder: "Введите текст", class: "form-control shadow-sm", rows: 5, required: true, minlength: 2 %>
          </div>

          <!-- Загрузка изображения -->
          <div class="mb-3">
            <%= f.label :image, "Загрузить новое изображение", class: "form-label fw-semibold" %>
            <%= f.file_field :image, class: "form-control shadow-sm" %>
          </div>

          <!-- Кнопки -->
          <div class="d-grid mt-4">
            <%= f.submit t('.submit_article', default: "Сохранить изменения"), class: "btn btn-success btn-lg shadow" %>
          </div>
          <div class="text-center mt-3">
            <%= link_to t('.back_to_all_articles', default: "Вернуться ко всем статьям"), articles_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>

      </div>

    </div>
  </div>
</section>
