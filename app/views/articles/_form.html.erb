<% provide :page_title, 'Edit Article' %>

<div class="container mt-5">

  <!-- Заголовок -->
  <h2 class="mb-4"><%= t('.title') %></h2>

  <!-- Форма -->
  <%= form_for :article, url: article_path(@article), method: :patch, html: { class: "needs-validation", novalidate: true } do |f| %>

    <!-- Ошибки -->
    <%= render 'shared/errors', object: @article %>

    <!-- Поле: Title -->
    <div class="mb-3">
      <%= f.label :title, class: "form-label fw-semibold" %>
      <%= f.text_field :title, placeholder: "Enter title", class: "form-control", required: true, minlength: 2 %>
    </div>

    <!-- Поле: Text -->
    <div class="mb-3">
      <%= f.label :text, class: "form-label fw-semibold" %>
      <%= f.text_area :text, placeholder: "Enter your text", class: "form-control", rows: 5, required: true, minlength: 2 %>
    </div>

    <!-- Загрузка изображения -->
    <div class="mb-4">
      <%= f.label :image, class: "form-label fw-semibold" %>
      <%= f.file_field :image, class: "form-control" %>
    </div>

    <!-- Кнопки -->
    <div class="d-flex justify-content-between">
      <%= f.submit t('.submit_article'), class: "btn btn-primary" %>
      <%= link_to t('.back_to_all_articles', default: "Show all articles"), articles_path, class: "btn btn-outline-secondary" %>
    </div>

  <% end %>

</div>
